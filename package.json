{
  "name": "gaurav-kothari-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "og": "npm run og -w client"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
