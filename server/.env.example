# Copy this file to .env and fill in the values.

PORT=5000

# MongoDB connection string (MongoDB Atlas free tier works fine).
# Leave empty to run without a database: the site still works, enquiries just aren't saved.
MONGODB_URI=

# Long random string. Needed to read saved enquiries from GET /api/enquiries
# (send it in the "x-admin-token" header). Leave empty to disable that endpoint.
ADMIN_TOKEN=
